{
  "name": "buggd",
  "version": "1.1.0-rc.1",
  "private": true,
  "description": "Local-first website testing with automatic crawling, evidence and reports",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"node --import tsx --watch src/cli/dev.ts\" \"vite --host 127.0.0.1 --strictPort\"",
    "brand:generate": "node --import tsx scripts/generate-brand.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run accessibility:generate && npm run typecheck && npm run brand:generate && tsc -p tsconfig.server.json && node scripts/finalize-build.mjs && vite build",
    "preview": "node lib/cli/index.js --no-open",
    "test": "vitest run",
    "predev": "npm run accessibility:generate && npm run brand:generate",
    "test:e2e": "playwright test",
    "browser:install": "node node_modules/playwright/cli.js install chromium",
    "start": "node lib/cli/index.js",
    "lint": "eslint .",
    "format": "prettier --write src web/src tests fixtures scripts *.ts *.json *.js",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "package:smoke": "node scripts/package-smoke.mjs",
    "accessibility:generate": "node scripts/build-accessibility.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/google-sans-code": "^5.3.2",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "dom-accessibility-api": "^0.7.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "lucide-react": "^1.63.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skillman85/Buggd.git"
  },
  "bin": {
    "buggd": "lib/cli/index.js"
  },
  "files": [
    "lib",
    "dist",
    "LICENSE",
    "README.md",
    "docs/security.md",
    "docs/brand/font-licenses",
    "THIRD_PARTY_NOTICES.md",
    "web/public/brand/buggd-logo-light.svg",
    "web/public/brand/buggd-logo-dark.svg",
    "docs/licenses"
  ]
}
