{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["web", "tests"]
}
